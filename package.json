{
  "name": "unione-nestjs",
  "version": "1.3.0",
  "description": "UniOne Web API for NestJS: API client module, webhooks, Nodemailer transport",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "unione": "^2.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": "*"
  },
  "keywords": [
    "unione",
    "nestjs",
    "email",
    "nodemailer",
    "webhook"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unione-repo/unione-nestjs.git"
  },
  "homepage": "https://docs.unione.io/en/web-api-ref",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "nodemailer": ">=6.9"
  }
}
